bin/
obj/
/packages/
riderModule.iml
/_ReSharper.Caches/

# Test output / coverage (produced by `dotnet test --collect`)
TestResults/
coverage.cobertura.xml

# Verify snapshot tests: *.verified.* is the committed baseline; *.received.* is transient.
*.received.*

# Stryker mutation testing output
StrykerOutput/

# Appsettings
appsettings.*.json
.env.*

# Local Data Protection key ring (see DataProtection:KeyRingPath in appsettings.json)
/GeoClubBot.API/dataprotection-keys/

# Locally-built Club Dashboard Activity assets, copied here only for "serve from the API" testing.
# In production the Docker build bundles these into the image's wwwroot instead.
GeoClubBot.API/wwwroot/

# Misc files
OldHistory.json
ChallengesConfig.json
.VSCodeCounter
.idea/

# graphify knowledge graph (generated, rebuilt via git hooks / `graphify update .`)
graphify-out/

# Left over from when Qdrant used a host bind mount; it now uses a named volume.
# The directory is root-owned (written by the container) and can be deleted manually.
qdrant_storage
