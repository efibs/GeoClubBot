<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>GeoClubBot.ApiProbe</RootNamespace>
    </PropertyGroup>

    <!-- No ProjectReference and no PackageReference, on purpose - see README.md:
         * the probe prints raw JSON, because the solution's typed DTOs silently drop
           any field they don't declare, which is exactly what we use this tool to find;
         * not referencing GeoClubBot.Infrastructure keeps IGeoGuessrApi.CreateChallengeAsync
           (POST /v3/challenges) out of reach, so the probe cannot write even by accident. -->

    <ItemGroup>
        <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')"/>
    </ItemGroup>

</Project>
