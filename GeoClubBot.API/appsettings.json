{
  "ConnectionStrings": {
    "PostgreSQL": "your;connection;string"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "[yyyy-MM-dd HH:mm:ss] "
      }
    }
  },
  /* In production, override AllowedHosts (e.g. via the AllowedHosts env var) with the
     real host name(s), comma-separated, to mitigate Host-header injection. "*" accepts any. */
  "AllowedHosts": "*",
  "Discord": {
    "BotToken": "YourDiscordBotTokenHere",
    "ServerId": 123456789,
    "WelcomeMessage": "Welcome {{User}} to {{Guild}}! Member #{{NumMember}}.",
    "WelcomeTextChannelId": 123456789,
    "LeftMessage": "{{User}} has left the server. Goodbye!",
    "LeftTextChannelId": 123456789,
    /* How long the website's online count (Discord's approximate presence count) is cached. */
    "OnlineCountCacheTimeToLive": "00:01:00"
  },
  "GeoGuessr": {
    /* The full roster sync. Joins and leaves arrive within seconds over the GeoGuessrSocket section's
       socket, and a club whose socket is down is synced every PollWhileDisconnected, so this is only
       the safety net.
       See https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontriggers.html for syntax */
    "SyncSchedule": "0 0 */6 ? * * *",
    "ActivityNcfaToken": "YourActivityReadNcfaTokenHere",
    "UserProfileNcfaToken": "YourUserProfileNcfaTokenHere",
    "ActivityCacheTimeToLive": "00:05:00",
    "UserProfileCacheTimeToLive": "00:30:00",
    "UserRankedSystemCacheTimeToLive": "00:30:00",
    "MissionBoardCacheTimeToLive": "00:01:00",
    /* How long a club's level, members, rank and XP are cached for the website. */
    "ClubCacheTimeToLive": "00:30:00",
    "Clubs": [
      /* Per-club overrides are optional; omitted values come from the ActivityChecker section:
         MinXP, GracePeriodDays, MaxNumStrikes, AverageXp*, MissionCompletionSlowestN, and — merged key by key —
         "Requirements": { "BoardMission": 0 }, "RuleXpMaxCountedPerWeek": { ... }, plus
         "RuleXpExcludedKinds": [ ... ] (replaces the global list), "RemindMissions": false,
         "NotifyApplications": false, "UseSocket": false and "SocketPollWhileDisconnected": "02:00:00".
         The NcfaToken must belong to a member of that club: the mission board is read with it. */
      { "ClubId": "your-club-id", "NcfaToken": "YourGeoGuessrNcfaTokenHere", "IsMain": true, "RoleId": 123456789 }
    ]
  },
  "ActivityChecker": {
    /* Just after GeoGuessr's weekly board reset (12:00 UK time), so a check covers one board week.
       See https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontriggers.html for syntax */
    "Schedule": "0 5 12 ? * WED *",
    /* IANA zone of the schedule; "Europe/London" follows GeoGuessr's reset through daylight saving. */
    "TimeZone": "Europe/London",
    "TextChannelId": 123456789,
    /* Minimum entries of an activity kind per week. DailyChallengeOrDuel counts streak days,
       BoardMission finished board missions (claimed by the member; helping doesn't count). */
    "Requirements": {
      "DailyChallengeOrDuel": 6,
      "BoardMission": 2
    },
    /* Minimum rule XP per week; 0 means no XP requirement. */
    "MinXP": 0,
    /* Rule XP — what averages, swap suggestions and the MVP use: the board-clear bonus is left out and
       at most 3 board missions per week count. */
    "RuleXp": {
      "ExcludedKinds": [ "BoardClearBonus" ],
      "MaxCountedPerWeek": { "BoardMission": 3 }
    },
    /* Longest stretch of activity feed one check reads (first check, or after downtime). */
    "MaxFeedLookback": "8.00:00:00",
    "GracePeriodDays": 2,
    "MaxNumStrikes": 2,
    /* Optional average-XP report: how many top/bottom members to list. Null omits that section. */
    "AverageXpTopN": null,
    "AverageXpBottomN": null,
    /* Weeks of history the average-XP figures are computed over. */
    "AverageXpHistoryDepth": 4,
    /* Optional mission-completion report (needs MissionClaimTracking): how many of the members slowest
       to finish their claimed board missions to list, plus everyone who left a claim unfinished.
       Null omits the report. */
    "MissionCompletionSlowestN": null,
    "HistoryKeepTimeSpan": "30.00:00:00",
    "StrikeDecayTimeSpan": "178.00:00:00"
  },
  "ActivityReward": {
    "TextChannelId": 123456789,
    "MvpRoleId": 123456789,
    /* Rank the MVPs by rule XP (no board-clear bonus, capped missions) instead of raw club XP. */
    "UseRuleXp": true
  },
  "SwapSuggestions": {
    /* After the weekly check, suggest which second-club members should move into the main club.
       Suggestions only — the bot never moves anyone. */
    "Enabled": false,
    /* Null posts to the ActivityChecker channel. */
    "TextChannelId": null,
    /* Weeks of rule XP averaged. */
    "HistoryDepth": 2,
    /* How much higher a second-club member's average must be for a swap. */
    "BufferXp": 10,
    /* GeoGuessr's club size limit; fewer main-club members means free spots to promote into. */
    "MaxClubSize": 30,
    "SuggestReplacementsForKicks": true,
    "SuggestPromotions": true
  },
  "ActivityViews": {
    /* Longest window of the last-days views. The activity feed reaches back a little over two weeks. */
    "MaxDaysBack": 14,
    /* Show how many missions of others a member pressed "help out" on (unverified). */
    "ShowHelps": true
  },
  "MissionBoard": {
    /* When the daily claim allowance resets. Only a fallback: the board reports it itself. */
    "ClaimResetTimeOfDay": "12:00:00",
    "ClaimResetTimeZone": "Europe/London"
  },
  "MissionBoardAlerts": {
    /* Alerts about board missions that hold the club up. Each mission is alerted about once per kind. */
    "Enabled": false,
    /* Quartz reads this at start-up even while alerts are off, so it must always be present.
       See https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontriggers.html for syntax */
    "Schedule": "0 */15 * ? * * *",
    "TextChannelId": 123456789,
    /* Clubs to watch; empty watches every configured club. */
    "ClubIds": [],
    /* Null disables that kind of alert. */
    "OpenClaimAlertAfter": "06:00:00",
    "HelpRequestAlertAfter": "01:00:00",
    /* Only alert while at most this many missions of the current board are left; 0 always alerts. */
    "LastMissionsThreshold": 3,
    /* Open-claim alerts mention the claimer; help-request alerts mention the club's RoleId instead. */
    "MentionClaimer": true,
    "MentionClubRoleOnHelpRequest": true,
    "DmClaimer": false
  },
  "MissionClaimTracking": {
    /* Records every board mission claim, because GeoGuessr only serves the current and the previous
       board. The activity views and the weekly report read their completion times from it. */
    "Enabled": true,
    /* Quartz reads this at start-up even while tracking is off, so it must always be present. A board
       change pushed over GeoGuessr's socket records that club at once, so this is the safety net.
       See https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontriggers.html for syntax */
    "Schedule": "0 15 */6 ? * * *",
    /* How long recorded claims are kept. */
    "Retention": "120.00:00:00",
    /* How far back the weekly report's claim-to-completion averages reach; the activity views use their own period. */
    "AverageWindow": "14.00:00:00"
  },
  "GeoGuessrSocket": {
    /* GeoGuessr's WebSocket, one connection per club with that club's NcfaToken: member joins and
       leaves, club updates and mission board changes arrive within seconds instead of at the next
       scheduled run. Off, every club is refreshed every PollWhileDisconnected instead. */
    "Enabled": true,
    /* Applies joins and leaves from the pushed data. false makes every member event a full roster
       sync — the fallback should GeoGuessr's payloads ever stop carrying what the bot needs. */
    "UsePayloads": true,
    "MemberEvents": true,
    "MissionBoardEvents": true,
    "ClubUpdatedEvents": true,
    "Url": "wss://api.geoguessr.com/ws",
    "Origin": "https://www.geoguessr.com",
    "UserAgent": "GeoClubBot (+https://github.com/efibs/GeoClubBot)",
    /* The site's build id. GeoGuessr closes with 4200 once it is outdated (logged as a warning);
       take the current one from the site's page source then. */
    "ClientVersion": "web-1.8700-39ce1da",
    "HeartbeatInterval": "00:00:15",
    "KeepAlive": "00:00:20",
    "MaxFrameBytes": 4194304,
    /* Reconnect backoff after ordinary failures; a connection that lasted StableAfter starts it over. */
    "MaxBackoff": "00:05:00",
    "StableAfter": "00:01:00",
    /* Close 4100 (superseded): wait, doubling up to the maximum. */
    "SupersededYieldInitial": "00:15:00",
    "SupersededYieldMax": "01:00:00",
    /* Close 4200 (client outdated). */
    "ClientOutdatedRetry": "00:30:00",
    /* Handshake refused with 403 (presumably Cloudflare): wait, doubling up to the maximum. */
    "BlockedRetry": "01:00:00",
    "BlockedRetryMax": "06:00:00",
    /* The club's token rejected (401, close 1001 "Unauthorized", or the club topic denied). */
    "AuthRetry": "00:30:00",
    /* Events are collected this long from the first one, then applied together, so a club switch
       (a leave on one club's socket, a join on the other's) is one switch. */
    "BatchWindow": "00:00:10",
    /* How often a club whose socket is down — or off — is refreshed from the API. */
    "PollWhileDisconnected": "01:00:00",
    /* A club's socket down this long is logged as a warning (so the log channel sees it), at most
       once per RepeatAlertAfter; a rejected token as an error, at most once per RepeatAuthAlertAfter. */
    "AlertAfter": "00:02:00",
    "RepeatAlertAfter": "06:00:00",
    "RepeatAuthAlertAfter": "1.00:00:00"
  },
  "ClubApplicationNotifications": {
    /* Announces new applications to the clubs. Each club's NcfaToken needs the ManageApplications
       permission; set "NotifyApplications": false on a club entry to leave that club out. */
    "Enabled": false,
    /* Quartz reads this at start-up even while notifications are off, so it must always be present.
       See https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontriggers.html for syntax */
    "Schedule": "0 */5 * ? * * *",
    "TextChannelId": 123456789,
    /* Role mentioned in each notification; null mentions none. */
    "RoleIdToPing": null
  },
  "ClubChatForwarding": {
    /* Right-click a Discord message → Apps → "📢 Send to club chat" forwards it into the clubs'
       in-game chats, written as the account of each club's NcfaToken. Set "ForwardChat": false on a
       club entry to leave that club out. */
    "Enabled": false,
    /* Roles that may forward, besides members with Discord's Administrator permission. */
    "AdminRoleIds": [],
    /* Prefilled into the form. Placeholders: {text}, {author} (server display name), {channel}. */
    "Template": "{text}\n\nForwarded by {author} from our Discord server's announcement channel",
    /* GeoGuessr cuts chat messages to 300 characters, so longer text goes out in numbered parts. */
    "MaxMessageLength": 300,
    "MaxParts": 5,
    /* A part counts as sent once GeoGuessr echoes it back within this time. */
    "EchoTimeout": "00:00:05"
  },
  "ClubLevelChecker": {
    /* A level pushed over GeoGuessr's socket is applied at once (if GeoGuessr pushes it), so this is
       the safety net.
       See https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontriggers.html for syntax */
    "Schedule": "0 0 */6 ? * * *",
    "LevelUpMessageChannelId": 123456789
  },
  "DailyChallenges": {
    /* See https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontriggers.html for syntax */
    "Schedule": "0 0 17 ? * * *",
    "TextChannelId": 123456789,
    "ConfigurationFilePath": "../ChallengesConfig.json",
    "FirstRoleId": 123456789,
    "SecondRoleId": 123456789,
    "ThirdRoleId": 123456789
  },
  "CountryChallenges": {
    /* Master switch. While false nothing is created or posted, and the file below is never read. */
    "Enabled": false,
    /* When the day's country challenges are posted — together with due results and the leaderboard.
       Quartz reads this at start-up even while the feature is off, so it must always be present.
       See https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontriggers.html for syntax */
    "Schedule": "0 0 17 ? * * *",
    /* IANA id. The schedule runs in this zone, and it decides which weekday "today" is. */
    "TimeZone": "UTC",
    /* The challenges, messages, points and everything else. Re-read on every run, so edits apply
       without a restart. See Documentation/CountryChallengesGuide.md. */
    "ConfigurationFilePath": "../CountryChallengesConfig.json"
  },
  "GeoGuessrAccountLinking": {
    "AdminChannelId": 123456789,
    "HasLinkedRoleId": 123456789
  },
  "DiscordActivity": {
    /* Club Dashboard Discord Activity (embedded web app). Disabled until Enabled is true and the
       OAuth client id/secret from the Discord Developer Portal are filled in. */
    "Enabled": false,
    "ClientId": "YourDiscordApplicationClientId",
    "ClientSecret": "YourDiscordApplicationClientSecret"
  },
  "Website": {
    /* Public numbers for the club website: GET /api/v1/stats (anonymous, any origin). Answers 404
       while Enabled is false. SecondClubId is the club shown next to the main club; it must be one
       of GeoGuessr:Clubs and not the main club. */
    "Enabled": false,
    "SecondClubId": null
  },
  "MemberPrivateChannels": {
    "Description": "This is your private text channel!",
    /* The bot creates the categories for the members' channels itself, one per club ("{club}" is the
       club's name), and opens "<name> 2" when a club's category holds MaxChannelsPerCategory channels
       (Discord allows 50). A club's category is visible to the club's role and the admin roles; each
       channel only to its member and the admin roles (and anyone with Administrator). */
    "CategoryNameTemplate": "{club} – Private",
    "MaxChannelsPerCategory": 45,
    "AdminRoleIds": [],
    /* After the start-up sync, move every channel where it belongs, recreate missing ones and fix their
       permissions. /private-channels-admin reconcile does the same on demand, with a dry run. */
    "ReconcileOnStartup": true,
    /* When a member leaves every club their channel is moved here instead of being deleted, so
       admins can still reach them about the kick and a hop to the second club doesn't throw the
       message history away. Rejoining moves the channel back. When it holds MaxChannelsPerCategory
       channels, the one archived the longest is deleted to make room. */
    "ArchiveCategoryId": 123456789,
    /* How long an archived channel is kept before it is deleted for good. */
    "ArchiveKeepTimeSpan": "30.00:00:00",
    /* See https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontriggers.html for syntax */
    "ArchiveCleanupSchedule": "0 45 3 ? * * *"
  },
  "SelfRoles": {
    "TextChannelId": 123456789,
    "Roles": [
      {
        "RoleId": 123456789,
        "RoleEmoji": ":first_place:",
        "RoleDescription": "A role description"
      }
    ]
  },
  "DailyMissionReminder": {
    "Schedule": "0 * * ? * * *",
    /* {{outstanding_text}} is built from the parts below, joined with Joiner, and ends with "!". */
    "DefaultMessage": "Don't forget to {{outstanding_text}}",
    "MaxRemindersPerUser": 5,
    "RemindChallenge": true,
    "RemindClaim": true,
    "RemindOpenMission": true,
    "ChallengeText": "play the daily challenge (or a duel)",
    /* {{free_count}}, {{board_number}}, {{claim_reset}} (relative Discord timestamp). */
    "ClaimText": "claim a club mission ({{free_count}} still free on board {{board_number}}, the daily claim resets {{claim_reset}})",
    /* For users whose GeoGuessr account isn't linked, so the board can't be matched to them. */
    "GenericClaimText": "claim a club mission if one is free",
    /* {{mission_title}}, {{progress}}, {{claimed_at}}. */
    "OpenMissionText": "finish your club mission **{{mission_title}}** ({{progress}}) or request help",
    "Joiner": " and "
  },
  "ClubXp": {
    /* How GeoGuessr's club activity feed awards XP. The feed's numeric activity type is the
       authoritative signal; this maps an XP amount to an activity kind for entries without one,
       e.g. { "100": "BoardClearBonus" }. Amounts not listed are unknown. */
    "UntypedXpFallback": {}
  },
  "DailyActivitySnapshot": {
    /* Snapshots the previous UTC day's per-member activity (streak, missions, XP); keep shortly after midnight UTC.
       See https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontriggers.html for syntax */
    "Schedule": "0 10 0 ? * * *"
  },
  "AI": {
    "Active": false,
    /* Per attempt at the AI provider, until it starts answering; a hung attempt is retried. */
    "RequestTimeoutSeconds": 60,
    /* How long a reply may take to arrive in full once the provider has started answering: in effect,
       how long a model may take to write one reply. A model still going after it is cut off and demoted
       for a while, and other models are asked. The slowest ordinary reply measured took 68 seconds. */
    "ResponseTimeoutSeconds": 90,
    /* A whole call, including waiting out the provider's per-minute window after a 429, retrying, and
       reading the reply. Keep it above RequestTimeoutSeconds plus a minute, and well above
       ResponseTimeoutSeconds. */
    "OverallTimeoutSeconds": 180,
    /* Quartz reads these at start-up even when Active is false, so they must always be present. */
    "ModelCatalogRefreshSchedule": "0 0 */6 * * ?",
    "ConversationCleanupSchedule": "0 30 3 * * ?",
    "CatalogSyncSchedule": "0 0 4 ? * SUN",
    "IngestionSchedule": "0 0 5 * * ?",
    /* Before the indexing run, so the share of the day's allowance that describing pictures may
       spend is claimed first; indexing then claims up to its own ceiling and answers have the rest. */
    "CaptionSchedule": "0 30 4 * * ?",
    /* When the clue of the day is posted (AI:ClueOfTheDay), in ClueOfTheDayTimeZone. Quartz reads it at
       start-up even while the feature is off, so it must always be present. */
    "ClueOfTheDaySchedule": "0 0 17 * * ?",
    /* IANA or Windows time-zone id the schedule is read in; empty or missing means UTC. */
    "ClueOfTheDayTimeZone": "Europe/Berlin",
    "MaxConcurrentRequests": 4,
    /* Channels the bot answers in. Empty means every channel it can see. */
    "AllowedChannelIds": [],
    /* Prefix of the vector collection; the embedding model and its dimensions are appended
       automatically, so changing either starts a fresh collection rather than mixing
       incomparable vectors into the existing one. */
    "KnowledgeCollectionPrefix": "geo-knowledge",
    "MaxRequestsPerUserPerHour": 6,
    /* Pictures attached to one answer, in total: every cited excerpt's first picture, then the further
       pictures of excerpts that bring several (a slide caption beside each picture of its slide).
       Discord shows at most 10 per message. */
    "MaxImagesInReply": 6,
    "ImageRelay": {
      /* Public base URL of this bot, e.g. "https://host.tailnet.ts.net". Must be reachable from the
         public internet, because the AI provider fetches images server-side — not the user's browser.
         It cannot be inferred: behind a tunnel or reverse proxy the bot only sees an internal
         address. Left empty, relaying is off and images from the hosts below are simply not indexed
         as pictures. */
      "PublicBaseUrl": "",
      "Directory": "/app/ai-images",
      /* Hosts whose images are copied rather than linked, because they refuse unattended clients. */
      "RelayHosts": [ "plonkit.net" ],
      "MaxImageBytes": 8388608,
      /* Answers upload the relayed pictures they cite instead of linking them, so they show even when
         Discord cannot reach PublicBaseUrl. Bytes uploaded per answer; pictures past it are linked.
         Keep it below the server's upload limit (10 MiB without boosts). 0 links every picture. */
      "MaxUploadBytesPerAnswer": 8388608,
      /* Largest single picture uploaded; a bigger one is linked. */
      "MaxUploadBytesPerPicture": 8388608,
      /* How long /ai status waits for PublicBaseUrl/health before calling it unreachable. */
      "ReachabilityTimeoutSeconds": 5
    },
    "Ingestion": {
      /* Sources indexed per run. Each costs embedding requests against the daily allowance, so a
         large library is indexed over several nights rather than in one burst. */
      "MaxSourcesPerRun": 25,
      "ReingestAfterDays": 14,
      /* Per attempt at a guide site. Google spends up to a minute building a document export before
         it either arrives or is refused, so this has room for that. */
      "SourceRequestTimeoutSeconds": 120,
      /* A whole fetch, the download included: queueing behind the politeness limiter, the attempts
         and the backoff between them. */
      "SourceOverallTimeoutSeconds": 300,
      /* Largest document page or export downloaded. A document is read from its mobile page, whose
         pictures are fetched one by one; the archive export is only its stand-in, and a guide of a few
         pages can carry a third of a gigabyte of images in one. Past this the export is abandoned and
         the text-only export is indexed instead. */
      "MaxDocumentExportBytes": 33554432,
      /* Longest side, in pixels, a Google document's pictures are downloaded at. The document's page
         serves each picture at the size asked for; 1600 keeps a map's small print readable at about
         270 kB a picture. */
      "DocumentPicturePixels": 1600,
      /* Largest slide deck downloaded. Decks are far heavier than documents (median 19 MB, largest
         339 MB in the library) and their pictures are the point; past this the deck's text export is
         indexed instead, without pictures or slide links. Held in memory while it is read. */
      "MaxDeckExportBytes": 536870912,
      /* Days before a deleted or no-longer-shared source is checked again. A second check that still
         finds it deleted removes it from the index, so answers stop citing a dead link. */
      "UnavailableRecheckDays": 30,
      /* Sources whose last attempt failed that one run retries. Taken after everything else, fewest
         failures first, so a backlog of broken links cannot crowd out work that will succeed. */
      "MaxFailingRetriesPerRun": 5,
      /* Days a source can go unlisted by every catalogue before its chunks leave the index; 0 keeps
         them for ever. A library edit can drop a guide for a week and put it back. */
      "RemovedSourceGraceDays": 30,
      /* Indexing and answering share one daily counter, and indexing runs overnight. This ceiling
         reserves the remainder for questions so a backfill cannot leave the bot mute all day. */
      "MaxDailyBudgetPercent": 60,
      /* Google Sheets id of a community guide library to sync from. Empty disables the sync: the
         library belongs to someone else, so pointing at one is a deliberate choice. */
      "MetaLibrarySheetId": "",
      /* Some sites block unattended fetches of their images, and the embedding provider fetches them
         server-side. Turn this off to index text only. */
      "EmbedImages": true
    },
    "ClueOfTheDay": {
      /* One lesser-known clue with its picture, posted to TextChannelId on ClueOfTheDaySchedule: drawn
         at random from the guides other than PlonkIt, with words of its own, not posted within
         NoRepeatDays. Costs no AI request. Off until a channel is chosen. */
      "Enabled": false,
      "TextChannelId": null,
      /* Days before the same clue may be posted again. */
      "NoRepeatDays": 180,
      /* Leave out clues PlonkIt has a tip like, as a question for "a clue I don't know" does. */
      "ExcludeMainGuideClues": true,
      /* Clues drawn per post to choose from, in case the first were posted recently. */
      "Draws": 8,
      /* What the post opens with; {{guide}} is the guide's title. */
      "Heading": "🧭 **Clue of the day** — from *{{guide}}*"
    },
    "Quiz": {
      /* /ai quiz: a random captioned guide picture with the answer behind a spoiler, for practising
         with the guides the club indexes. Costs no AI request. */
      "Enabled": true,
      /* Pictures drawn per question to find one with words of its own. */
      "Draws": 24,
      /* Keep the quiz to AI:AllowedChannelIds when that list is set. */
      "OnlyInAllowedChannels": true
    },
    "Captions": {
      /* Many guide pictures carry no caption and no words around them, so a written question cannot
         find them and an answer cannot say what they show. A free vision model describes each such
         picture once; the description is stored with the chunk, searched like a caption, and marked as
         generated wherever it is shown. Off, nothing is asked of any model. */
      "Enabled": true,
      /* Ceiling on the shared daily counter while describing: one chat request a picture plus one
         embedding request per batch. The job runs before indexing, so this share is claimed first. */
      "MaxDailyBudgetPercent": 20,
      /* Pictures described per run, whatever the allowance. */
      "MaxPicturesPerRun": 60,
      /* The generation of descriptions that is current. Raise it after a prompt change, or once a better
         free vision model is around: every picture described under an older generation is described
         again over the following runs. */
      "Version": 1,
      /* Longest description kept, in characters. */
      "MaxCaptionLength": 400,
      /* How long one picture may take the model before the next model is asked. */
      "TimeoutSeconds": 90,
      /* Whether a generated description is shown to members, marked "AI description", under a picture
         whose guide says nothing about it. Off, descriptions only make pictures findable and tell the
         answering model what they show. */
      "ShowToMembers": true,
      /* Unusable or failed replies in a row before a run stops and leaves the rest for the next night. */
      "MaxConsecutiveFailures": 3
    },
    "Conversation": {
      /* Replayed history, in messages. Roughly six exchanges. */
      "MaxTurns": 12,
      /* Hours of inactivity after which a reply starts a fresh conversation. Measured from the last
         message in that branch, so an active long thread is never cut off mid-discussion. */
      "MaxIdleHours": 24,
      "MaxContextCharacters": 12000,
      /* Images cost roughly 1800 tokens each, far more than the text around them. */
      "MaxImagesInContext": 2,
      "LongThreadDepth": 20,
      /* Stored questions are personal data; shorten this to keep less. */
      "RetentionDays": 30
    },
    "Feedback": {
      /* 👍/👎 on an answer. A rated conversation is copied into a permanent archive; unrated ones
         still vanish with Conversation:RetentionDays above, so nothing is kept without a verdict. */
      "Enabled": true,
      /* Unicode only: reactions are matched on the emoji's name, which is its codepoint for a
         standard emoji but the alias for a custom guild emote. */
      "PositiveEmoji": "👍",
      "NegativeEmoji": "👎",
      /* The bot puts both reactions on its own answer, because nobody rates what they do not know
         they can rate. Costs two REST calls per answer. */
      "PrefillReactions": true,
      /* Adds ✅ once an answer carries a verdict — it marks the answer, not any one reviewer. Without
         it a click that silently failed looks exactly like one that worked. */
      "ConfirmWithReaction": true,
      /* Days of rated conversations kept. 0 keeps them forever, which is the point of the archive:
         it is meant to outlive Conversation:RetentionDays. */
      "RetentionDays": 0,
      /* Entries in one /ai feedback-export. Discord caps an attachment at 8 MB. */
      "MaxExportRecords": 2000
    },
    "Retrieval": {
      /* Every default here was measured by replaying the 2026-10-23 feedback export against the
         production index (Tools/GeoClubBot.RetrievalProbe compare); re-measure rather than guess. */
      /* Guide excerpts offered per question; every one cited is listed under the answer. Ten found two
         more of the excerpts the feedback named than eight; twelve one more, at a lower on-target share. */
      "ExcerptLimit": 10,
      /* Searches a follow-up together with the question before it. "What about corn?" alone found
         the Philippine corn tip 8th; with its branch, 1st. */
      "ContextualQuery": true,
      /* Earlier questions of the branch joined to a follow-up. */
      "ContextUserTurns": 1,
      /* How much a follow-up's own words count beside its branch (which counts 1). */
      "FollowUpQuestionWeight": 0.5,
      /* A follow-up is first offered again up to this many of the excerpts the answer it replies to
         cited, numbered [1].. in that answer's order, because "that picture" or "source 3" means one
         of them. Read back from the index by id: no request. 0 offers none again. */
      "MaxCarriedExcerpts": 6,
      /* A picture whose only text is a heading ("Distribution", "Svalbard — Identifying Svalbard")
         gives the model nothing to say; its fused score is multiplied by this. 1 leaves them be.
         Never applied to a screenshot question, where the heading names the look-alike's country. */
      "HeadingOnlyPictureWeight": 0.25,
      /* Weight of the list of chunks containing one of the planner's literal phrases ("no supports").
         0 searches none. */
      "KeyPhraseWeight": 0.5,
      "QueryPlanner": {
        /* One extra chat request per question that rewrites it for searching: a follow-up made
           standalone, the guides' own terms ("snow poles", not "snow bollards"), its countries.
           Skipped, never failing the question, when it is slow, fails or cannot be read.
           Off, because a planned question costs 3 requests instead of 2: at the DailyRequestBudget of
           45 below, planning to MaxDailyBudgetPercent leaves 17 answers a day instead of 22, for 2 more
           of the feedback's 24 named excerpts found (with a hand-picked fast model; the one the bot
           picked that day planned in time for 11 of 49 questions). Worth it with a 1000/day key. */
        "Enabled": false,
        /* The answer still has to be written after it, so this is kept short. How long planning takes
           is the model heading the chain's: nemotron-3-ultra 4.4 s median, dots-3-note-preview 34 s. */
        "TimeoutSeconds": 20,
        /* After a timeout the planner is skipped this long, so a slow model does not make every
           question wait for nothing. 0 never skips it. */
        "PauseAfterTimeoutMinutes": 30,
        "MaxPhrasings": 3,
        /* How much each extra phrasing counts against the rewritten question (1). */
        "PhrasingWeight": 0.5,
        /* How much a follow-up searched with its branch still counts once the planner rewrote it. */
        "ConversationWeight": 1,
        /* The planner stops once the day's requests pass this share of DailyRequestBudget, leaving
           the rest for answers. */
        "MaxDailyBudgetPercent": 75
      },
      "CountryBoost": {
        /* The countries a question is about are searched again within those countries, and the lists
           fused in: a soft boost, never a filter. */
        "Enabled": true,
        /* How much a country-filtered list counts against the same search unfiltered. At 2, 94% of the
           excerpts offered for a question naming a country came from it (73% before, 88% at 1). */
        "Weight": 2,
        /* More countries than this reads as a question about many places, which is boosted not at all.
           Five keeps the Nordic or Balkan countries boosted together. */
        "MaxCountries": 5,
        /* A screenshot's own pixel search counts this much when the question names a country: its
           look-alikes come from everywhere. */
        "ScreenshotWeightWhenNamed": 0.5,
        /* The index's country names are read (a scroll of every point) at most this often. */
        "CountryListCacheHours": 6,
        /* More names for a country or a region, e.g. { "sabah": [ "Malaysia" ] }. Added to the
           built-in ones (spellings, adjectives, common regions). */
        "Aliases": {}
      },
      "LesserKnown": {
        /* A question asking for something new ("a clue I don't know yet", "not on PlonkIt") is searched
           without PlonkIt's own tips, since PlonkIt is the guide most players have read, and each
           excerpt from another guide that tells a clue PlonkIt tells too is marked for the model to
           pass over. Costs no request: excerpts are compared by the vectors the index already holds. */
        "Enabled": true,
        /* How alike an excerpt and a PlonkIt tip of the same country must be (cosine of their text
           vectors) to count as the same clue. Measured on production on 2026-11-10: the same clue
           told twice scores 0.58 to 0.83, two different tips of one country up to about 0.55. Lower
           marks more; a clue wrongly passed over costs less than a PlonkIt staple offered as new. */
        "SameClueSimilarity": 0.57,
        /* Picture clues drawn at random for such a question when it names nothing to look for ("tell
           me a reliable clue I don't know yet", "another one please"): a search has only its wording
           to go by, and finds a guide's legend rather than a clue. Drawn from every guide but PlonkIt,
           one per guide, pictures with words of their own, none PlonkIt has a tip like; they lead the
           excerpts and the search's results fill the rest. Costs no request. 0 draws none. */
        "RandomPicks": 6
      }
    },
    "Tools": {
      /* Lets the answering model search the guides again in its own words, read more of a guide it
         was given, and look up where a plant species is recorded. Offered only to models that can
         call tools (never the fallback router) and only while the day's allowance can pay for a round.
         A question the model answers straight away still costs 2 requests; each further round costs
         1 chat request, plus 1 embedding request when it searches. Off answers every question in one call. */
      "Enabled": true,
      /* Rounds of tool calls one answer may take; the call after the last one has to answer. Two: in
         the 2026-10-29 answer replay no third round contributed a cited excerpt (11 answers took one),
         while the second did in five answers. */
      "MaxToolRounds": 2,
      /* Calls run per round; more are answered "not run". A round's searches share one embedding request. */
      "MaxToolCallsPerRound": 4,
      /* Seconds from the question's arrival after which no more tools are offered and the next call
         has to answer. Calls already under way are not cut short. */
      "AnswerDeadlineSeconds": 90,
      "SpeciesRange": {
        /* Where a plant, tree or crop is recorded, by country or by region of one, from GBIF's free
           API (no key, no AI request). Its counts are occurrence records, not abundance, and the model
           is told so. */
        "Enabled": true,
        /* Look the plant up before answering when a question asks where it is found, instead of
           waiting for the model to call the tool (it never did in the 2026-10-30 replay). Costs no AI
           request. Asked of the world, its countries lead the guides; asked of one country ("where in
           the US can you see cholla?"), its states or provinces follow them. */
        "LookUpWhereQuestions": true,
        "BaseUrl": "https://api.gbif.org",
        /* Per request; a failed one is retried once. */
        "RequestTimeoutSeconds": 10,
        /* How long an answer, and the map drawn of it, is kept in memory. 0 keeps none. */
        "CacheHours": 24,
        /* Countries, or regions of one, listed per answer, most records first. */
        "MaxAreas": 15,
        /* Fewest records a plant needs in one country before its records there are offered for a
           question about that country. Within a country the records follow who went looking, and a
           crop is hardly recorded at all (308 of sugar cane in the Philippines, none where it is
           grown most), while a plant people do record has thousands. */
        "MinRecordsInCountry": 500,
        "Map": {
          /* Draw where the plant is recorded as a map and attach it to the answer: GBIF's base map
             with the density of the records over it, framed on the country asked about or on the part
             of the world that holds the records. Free, no key. The picture is kept in the image
             relay, so this needs ImageRelay:PublicBaseUrl. */
          "Enabled": true,
          "TileBaseUrl": "https://tile.gbif.org",
          /* osm-bright-en names states and provinces, which is what makes a range readable as
             "southern Arizona, not Nevada"; gbif-light is calmer and names nothing. */
          "BaseMapStyle": "osm-bright-en",
          /* Seconds the whole map may take; the answer waits for it, and past this goes out without. */
          "TimeoutSeconds": 8
        }
      },
      "PlantIdentification": {
        /* Name the plant in a member's screenshot with Pl@ntNet (free: 500 identifications a day per
           account, reset at 00:00 UTC; commercial use allowed within that) when the question asks what
           plant it shows, and look the species up in GBIF for its countries and map. Nothing is sent
           without a key. */
        "Enabled": true,
        /* A Pl@ntNet API key from my.plantnet.org (free account). Empty leaves the feature off. */
        "ApiKey": "",
        "BaseUrl": "https://my-api.plantnet.org",
        /* "all" lets Pl@ntNet pick the flora; other project names come from /v2/projects. */
        "Project": "all",
        /* Language of the common names returned. */
        "Language": "en",
        /* Candidates offered to the model, best first. */
        "MaxCandidates": 3,
        /* Score from which the best candidate is taken for the plant and looked up in GBIF; below it
           the candidates are offered as guesses. A Street View frame is a poor photograph of a plant,
           so a clear match often scores 0.3-0.6. */
        "MinConfidence": 0.25,
        /* Identifications this bot makes a day, under Pl@ntNet's 500. Counted in memory. */
        "MaxRequestsPerDay": 450,
        /* Per request, the screenshot's download included. */
        "RequestTimeoutSeconds": 15,
        /* How long an identification is kept, by the screenshot's link, so a follow-up costs none. */
        "CacheHours": 24,
        /* Largest screenshot sent, in bytes. */
        "MaxImageBytes": 10485760
      },
      "RegionMap": {
        /* A small map of a country with the states or provinces an answer names coloured in, attached
           after the answer: "Lạng Sơn and Quảng Ninh" means little to a player who does not know where
           they are. Boundaries from Natural Earth (public domain, downloaded once), base map from GBIF's
           free tiles; needs ImageRelay:PublicBaseUrl like the species maps. */
        "Enabled": true,
        /* Let the model ask for a map itself (region_map tool) with a share per region, shaded darker
           where a clue is more common. The map after the answer highlights evenly and needs no call. */
        "ToolEnabled": true,
        /* Natural Earth's 1:10m admin-1 states and provinces as GeoJSON, about 40 MB. Delete the file
           from DataDirectory to fetch it again. */
        "BoundariesUrl": "https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_10m_admin_1_states_provinces.geojson",
        "DataDirectory": "ai-data",
        /* Degrees a boundary may be straightened when read; a hundredth is invisible on a country map. */
        "SimplifyToleranceDegrees": 0.01,
        /* Most regions on one map. */
        "MaxRegions": 15,
        /* Seconds the map after an answer may take; past this the answer goes out without it. */
        "TimeoutSeconds": 8,
        "CacheHours": 24,
        "DownloadTimeoutSeconds": 300
      }
    },
    "OpenRouter": {
      "ApiKey": "",
      "BaseUrl": "https://openrouter.ai",
      /* OpenRouter's free tier allows 50 requests/day below $10 of lifetime credit, and 1000/day
         above it. This default sits just under the lower ceiling; raise it after topping up,
         otherwise the bot throttles itself far below what the account actually allows. */
      "DailyRequestBudget": 45,
      /* Just under the provider's 20/min ceiling for free models, which the $10 top-up does not lift.
         Paced evenly across the minute rather than released in one lump. */
      "PerMinuteRequestBudget": 18,
      /* Model ids starting with any of these outrank everything else, e.g. "google/". Best first: a
         model matching an earlier prefix outranks one matching a later one. It orders the models that
         qualify; it does not let in one the size or uptime bar keeps out, and repeated failures still
         push it down. Asked the same grounded question on 2026-10-23, Nemotron 3 Ultra gave the best
         answer and Super VL the fastest correct one, while Dots 3, which the ranking alone puts second,
         wrote a URL it is told never to write. A prefix nothing matches any more simply does nothing.
         Environment variables replace these entries one at a time, by index, never the whole list:
         AI__OpenRouter__PreferredModelPrefixes__0=google/ replaces the first and keeps the second, and
         an override cannot shorten the list. To drop an entry, set it empty
         (AI__OpenRouter__PreferredModelPrefixes__1=); empty entries are ignored. */
      "PreferredModelPrefixes": [ "nvidia/nemotron-3-ultra", "nvidia/nemotron-3.5-super-vl" ],
      /* Models never to ask. /ai status lists any excluded at runtime for answering with something
         that is not an answer, or refusing to serve the bot; add them here to keep them out after a
         restart. The Inkling models answer anything but a coding agent with 403 "only available on
         agentic harnesses" (2026-10-23). The bot learns that only when the 403 reaches it, and
         OpenRouter's failover usually hides it, leaving them a chain slot they never use.
         Environment variables replace entries by index, as above: AI__OpenRouter__BlockedModelIds__0=x
         unblocks Inkling to block x. To block more, add indexes after the shipped ones
         (AI__OpenRouter__BlockedModelIds__2=...); to unblock one, set its index empty. */
      "BlockedModelIds": [ "thinkingmachines/inkling:free", "thinkingmachines/inkling-small:free" ],
      /* Router used only when too few vetted models qualify. It picks a free model at random —
         safety classifiers included — and cannot be told to avoid any, so its answers are screened. */
      "FallbackModelId": "openrouter/free",
      /* Vetted models named in one request. OpenRouter rejects a request naming more than three, so
         this is capped at 3. */
      "ChainLength": 3,
      "MinContextLength": 8192,
      /* Embeddings. Changing the model or its width invalidates every stored vector, which is why
         both are folded into the collection name. */
      "EmbeddingModelId": "nvidia/llama-nemotron-embed-vl-1b-v2:free",
      "EmbeddingDimensions": 2048,
      /* Inputs per embedding request. Batching is what makes indexing affordable: the provider
         limits requests, not inputs. */
      "EmbeddingBatchSize": 32,
      /* Largest embedding request body. Relayed images are sent inline, so big pictures split a batch
         early to stay under this. */
      "EmbeddingMaxRequestBytes": 8388608,
      "ExpiryHorizonHours": 48,
      /* Smallest model asked, in billions of effective parameters: √(total × active) for a mixture of
         experts, the total for a dense model. Read from the id, name and description; a model that
         states no size is not held to it. Dropped for a request no model that clears it could serve. */
      "MinEffectiveParametersBillions": 8,
      /* Models whose best provider served less of the last day's requests than this (percent) are not
         asked. Read on each catalog refresh; a failed read counts as healthy. Dropped like the size bar. */
      "MinProviderUptimePercent": 50,
      /* Models whose provider health one catalog refresh reads, from the head of the text and vision
         rankings. One free request each, through the same limiter as questions. Capped at 20; 0 turns
         the check off. */
      "HealthCheckModelCount": 10,
      "SiteUrl": "",
      "AppName": "GeoClubBot"
    }
  },
  "DiscordLogging": {
    /* Optional: forwards logs to a Discord channel. Disabled while ChannelId is 0. */
    /* MinimumLogLevel is inclusive (Warning sends Warning, Error and Critical). */
    "ChannelId": 0,
    "MinimumLogLevel": "Warning"
  },
  "SQL": {
    "Migrate": false
  },
  "DataProtection": {
    /* The Data Protection key ring is persisted here (relative paths resolve under the app's
       working directory). In production, mount a volume at this path so keys survive container
       recreation instead of a fresh, ephemeral key ring being generated on every redeploy. */
    "KeyRingPath": "dataprotection-keys",
    /* Optional but recommended in production: encrypts the key ring at rest with a certificate
       (Linux has no OS-level fallback like Windows DPAPI, so without this the keys sit on the
       volume as plain XML). Generate a self-signed cert once, e.g.:
         openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 3650 -nodes -subj "/CN=GeoClubBot"
         openssl pkcs12 -export -out dataprotection.pfx -inkey key.pem -in cert.pem -passout pass:<password>
       Store the .pfx alongside the key ring volume, but set CertificatePassword via an env var/secret
       — never commit it or store it on the same volume as the .pfx. Left empty, the key ring is
       still persisted but unencrypted. */
    "CertificatePath": "",
    "CertificatePassword": ""
  }
}
